# Copy values into backend/.env and ai-service/.env before `docker compose up`.
# Docker compose overrides DATABASE_URL and AI_SERVICE_URL for the containers.
AI_SERVICE_TOKEN=dev-ai-token
# ai-service/.env must have:
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-5-mini
#   SERVICE_TOKEN=dev-ai-token
