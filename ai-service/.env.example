# ================= LaalPen AI service (.env) =================
# auto = OpenAI when OPENAI_API_KEY is set, otherwise the free mock checker (for trying the app).
# Force one with: openai | gemini | mock
AI_MODE=auto

# ---- OpenAI: paste your key here — that is all you need for real checking ----
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# vision model that reads handwriting (cheap and accurate). Change any time.
OPENAI_MODEL=gpt-5-mini
# optional: a cheaper model for easy copies, and a stronger one only for the few unsure answers
CHEAP_MODEL=
ESCALATION_MODEL=

# ---- Optional: Google Gemini for copies written in Urdu (free tier available) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Must match AI_SERVICE_TOKEN in backend/.env
SERVICE_TOKEN=dev-ai-token

# ---- Accuracy / cost knobs (defaults are fine) ----
# below this confidence an answer goes to the teacher as "Check"
REVIEW_CONFIDENCE=0.7
# extra AI looks only for unsure / partial-credit theory answers (0 = off)
SELF_CONSISTENCY_SAMPLES=2
MAX_IMAGE_SIDE=1600
MAX_OUTPUT_TOKENS=6000
# photo checks before any AI call (blur / dark / glare / small photo)
BLUR_THRESHOLD=60
DARK_THRESHOLD=90
MIN_SIDE_PX=900
# your own prices for the cost report, e.g. {"gpt-5-mini":[0.25,0.025,2.0]} (USD per 1M input, cached, output)
MODEL_PRICES_JSON=

# Optional error monitoring (pip install sentry-sdk)
SENTRY_DSN=
