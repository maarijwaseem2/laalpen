# ===== LaalPen app (.env) — every variable must start with EXPO_PUBLIC_ =====

# Backend URL. Leave EMPTY during development: the app finds your computer's IP automatically
# (works when phone and computer are on the same Wi-Fi). Set it for production, e.g. https://api.yourschool.pk
EXPO_PUBLIC_API_URL=
# Live build (web at https://laalpen.vercel.app, Android APK): EXPO_PUBLIC_API_URL=https://laalpen-backend.onrender.com

# ---- Google login (Firebase, free). Firebase console > Project settings > Your apps > Web app ----
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Google Cloud > Credentials > "Web client (auto created by Google Service)" — needed for Android/iOS Google login
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only: the reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
