# ================= LaalPen backend (.env) =================
# Copy to .env. Everything below works for FREE on your own computer; paid services are switched on
# later only by filling in their keys here — no code changes.
NODE_ENV=development
PORT=4000
# all = API + checking workers (one computer). For bigger schools run extra copies with LAALPEN_ROLE=worker
LAALPEN_ROLE=all

# ---- PostgreSQL: point this at YOUR database ----
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/laalpen?schema=public"
# Only when DATABASE_URL goes through a pooler (Neon/Supabase "pooled" URL): the direct URL for the job queue
DIRECT_DATABASE_URL=

# Comma separated web origins, or * during development
CORS_ORIGINS=*
# Live (website + web app on one domain): CORS_ORIGINS=https://laalpen.vercel.app
# Where the web app runs (links in emails) and where phones reach this API (upload links, share links).
# Testing on a phone? Use your computer's Wi-Fi IP, e.g. http://192.168.1.20:4000
APP_URL=http://localhost:8081
PUBLIC_API_URL=http://localhost:4000
# Live: APP_URL=https://laalpen.vercel.app  PUBLIC_API_URL=https://laalpen-backend.onrender.com
APP_SCHEME=laalpen

# ---- Security: in production change ALL of these to long random strings (32+ characters) ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
FILE_SIGNING_SECRET=change-me-file-secret
TOTP_ENCRYPTION_KEY=change-me-totp-key-32-characters-long!!
DATA_ENCRYPTION_KEY=change-me-data-key-32-characters-long!!
# principals/admins must turn on the authenticator app (or a passkey) before opening school data
REQUIRE_ADMIN_2FA=true
# a new phone/computer must confirm with an emailed code for these roles (empty = off)
DEVICE_CONFIRM_ROLES=ADMIN,TEACHER
# refuse passwords found in public data breaches (free "Have I Been Pwned" check, privacy-safe)
BREACHED_PASSWORD_CHECK=true
MAX_FAILED_LOGINS=10
LOCK_MINUTES=15
# "confirm it's you" before re-opening published marks, promotion, imports, exports
STEP_UP_MINUTES=10
# passkeys: your web domain (e.g. app.laalpen.pk) and the web address(es) of the app
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:8081
# Live: WEBAUTHN_RP_ID=laalpen.vercel.app  WEBAUTHN_ORIGINS=https://laalpen.vercel.app

# ---- Files: local (free, this computer) or s3 (Cloudflare R2 free 10 GB / AWS S3) ----
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=12
FILE_URL_TTL_MINUTES=120
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- AI service (FastAPI). Token must match SERVICE_TOKEN in ai-service/.env ----
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-ai-token
# how many copies are checked at the same time, and the AI calls per minute (stay under your OpenAI limit)
CHECK_INTERACTIVE_CONCURRENCY=2
CHECK_BULK_CONCURRENCY=2
AI_REQUESTS_PER_MINUTE=60
# overnight tests are sent to the half-price Batch API at this time
OVERNIGHT_CRON=0 21 * * *
TZ_SCHEDULE=Asia/Karachi

# ---- Email via Brevo (free 300/day). Empty = emails and codes are printed in this terminal ----
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@yourdomain.com
MAIL_FROM_NAME=LaalPen
OTP_TTL_MINUTES=10

# ---- Parents' phones: codes and results. Empty = printed in this terminal ----
# WhatsApp Cloud API (Meta): approved templates laalpen_code and laalpen_result
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=laalpen_code
WHATSAPP_RESULT_TEMPLATE=laalpen_result
# SMS fallback: console | twilio | http (any Pakistani SMS gateway with a GET/POST URL)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# e.g. https://sms.example.pk/send?key=XXXX&to={to}&text={text}
SMS_HTTP_URL=
SHARE_LINK_DAYS=30

# ---- Google login via Firebase (free). Project ID from Firebase console > Project settings ----
FIREBASE_PROJECT_ID=

# ---- Optional error monitoring (Sentry free tier). Empty = off ----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Demo school, teachers, students and checked copies when you run: npm run db:seed
SEED_DEMO=true
# password of the demo accounts (demo data only)
SEED_DEMO_PASSWORD=Demo@1234
